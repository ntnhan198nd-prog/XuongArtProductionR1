# App URL (used for server-side internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin login
ADMIN_PASSWORD=change_this_password
ADMIN_SESSION_SECRET=change_this_random_secret

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name

# Public URL used by end users to load files (custom domain or r2.dev)
# Example: https://media.yourdomain.com
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://your-public-r2-domain
